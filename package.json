{
  "name": "@harms-haus/engin",
  "version": "0.1.0",
  "description": "An AI-powered development engine with dynamic profile and workflow discovery.",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "development",
    "automation",
    "llm",
    "engine"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "engin": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "setup": "bun run build && bun dist/cli.js init",
    "test": "bun test tests/",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test tests/ --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0",
    "dotenv": "^16.5.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
