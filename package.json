{
  "name": "engin-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered development engine with dynamic profile and workflow discovery.",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "development",
    "automation",
    "llm",
    "engine"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared",
    "setup": "bun run build && bun packages/cli/src/cli.ts init",
    "test": "bun test && bun run --cwd packages/web test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
