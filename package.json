{
  "name": "workflow-harness",
  "version": "0.1.0",
  "description": "An AI-powered development workflow harness with dynamic profile and workflow discovery.",
  "keywords": ["ai", "agent", "workflow", "development", "automation", "llm", "harness"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "workflow-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "setup": "bun run build && bun dist/cli.js init",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "dotenv": "^16.5.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
